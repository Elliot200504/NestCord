# Copy to .env and fill in. Never commit the real .env.

# Environment — "development", "test" or "production". Defaults to development.
# Setting it to production makes the refresh cookie Secure (so the API must be
# behind HTTPS) and makes the seed refuse to run.
# NODE_ENV=development

# Database — matches the credentials in docker-compose.yml
DATABASE_URL="postgresql://nestcord:nestcord@localhost:5432/nestcord?schema=public"

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# URLs
API_PORT=3000
API_URL="http://localhost:3000"
WEB_URL="http://localhost:5173"

# Admins — comma-separated emails allowed to read the error log. Empty means nobody.
ADMIN_EMAILS=

# Attachments
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES=8388608

# Web (Vite only exposes VITE_* to the browser)
VITE_API_URL="http://localhost:3000"
# Comma-separated STUN servers for voice channels. STUN only — there is no TURN, so
# two peers behind strict NATs may not manage to connect.
VITE_STUN_URLS="stun:stun.l.google.com:19302"
