{
  "name": "nestcord",
  "version": "0.1.0",
  "private": true,
  "description": "A small-scale Discord clone built with NestJS and React",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm packages:build && pnpm --parallel --filter \"./apps/*\" dev",
    "packages:build": "pnpm --filter @nestcord/shared build && pnpm --filter @nestcord/database build",
    "build": "pnpm packages:build && pnpm --parallel --filter \"./apps/*\" build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @nestcord/database generate",
    "db:migrate": "pnpm --filter @nestcord/database migrate",
    "db:seed": "pnpm --filter @nestcord/database seed",
    "db:reset": "pnpm --filter @nestcord/database reset",
    "db:studio": "pnpm --filter @nestcord/database studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
